# Copy to .env (gitignored). The services do not need it: `scripts/local_demo.py`
# writes api/.env and apps/client/.env.local itself. It is read when the
# API is started by hand from the repository root, and by developer tools.

# The API, as in api/.env.example, which explains each one.
APP_MODE=local_demo
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence
TELEMETRY_TOKEN_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
IMD_API_BASE_URL=
SACHET_CAP_BASE_URL=

# Developer tools. Nothing in the running app reads these.
# scripts/tools/translate_catalogues.py drafts language catalogues with Sarvam Translate.
SARVAM_API_KEY=
