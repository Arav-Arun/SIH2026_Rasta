{
  "name": "@rasta/contracts",
  "version": "0.1.0",
  "private": true,
  "types": "./src/openapi.d.ts",
  "exports": {
    ".": {
      "types": "./src/openapi.d.ts"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "openapi.json",
    "src/openapi.d.ts"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/openapi.d.ts",
    "check": "openapi-typescript openapi.json -o src/openapi.d.ts --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
