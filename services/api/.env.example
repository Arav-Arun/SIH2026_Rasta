# Copy to services/api/.env (gitignored). `scripts/local_demo.py` and the
# acceptance runs write that file themselves from `supabase status`.
APP_MODE=local_demo
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence
# Signs the short-lived, trip-scoped credential a driver's device uses to file
# positions. Empty is fine for a single-worker local run: the service generates
# one per process and says so. Any deployment with more than one worker must set
# it, or a credential issued by one worker is rejected by the next.
TELEMETRY_TOKEN_SECRET=
# Web push (optional). Without all three, alerts reach the in-app inbox only,
# and the data-health screen says push is not configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Empty on purpose: RASTA has no confirmed IMD or SACHET access. Left empty,
# the API reads the recorded documents in data/fixtures/sources and labels
# every run `recorded`. A URL here makes it call that address as a live feed.
IMD_API_BASE_URL=
SACHET_CAP_BASE_URL=
