# Copy to api/.env (gitignored) and fill in the database and Supabase settings.
APP_MODE=local_demo
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Signs the short-lived, trip-scoped credential a driver's device uses to file
# positions. Empty is fine for a single-worker local run: the service generates
# one per process and says so. Any deployment with more than one worker must set
# it, or a credential issued by one worker is rejected by the next.
TELEMETRY_TOKEN_SECRET=
# Web push (optional). Without all three, alerts reach the in-app inbox only,
# and the data-health screen says push is not configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# A URL here makes the API call that address as a live feed. Left empty, it
# reads the recorded document in data/fixtures/sources and labels every run
# `recorded`. IMD's API needs credentials RASTA does not have, so it stays empty.
# SACHET publishes each state's CAP alerts as a public RSS feed; the API follows
# the feed to each alert and its polygon.
IMD_API_BASE_URL=
SACHET_CAP_BASE_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_meghalaya.xml
# The recorded documents carry their original issue times, so read as they are
# they are stale. `python -m app.recorded_samples <dir>` copies them re-dated to
# now (still labelled recorded); point this at that directory. Left unset, the
# API reads the originals in data/fixtures/sources. Do not set it empty: that
# turns the recorded sources off.
# SOURCE_FIXTURE_ROOT=/tmp/rasta-sources
# Re-score every district's roads this often, in minutes (5 to 1440); 0 leaves
# it to POST /v1/risk/recompute. In a demo, each round first re-dates the samples
# in SOURCE_FIXTURE_ROOT, but never the committed originals.
RISK_RECOMPUTE_MINUTES=0
# A trained risk model exported by ml/ (model_logistic.json) and its SHA-256, both
# or neither. It is refused unless the hash matches and it passed its gate, and it
# runs in shadow: logged beside baseline-v1, never used for routing or alerts.
# RISK_MODEL_FILE=ml/work/report/model_logistic.json
# RISK_MODEL_SHA256=
