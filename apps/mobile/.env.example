# Copy to apps/mobile/.env (gitignored) and fill in before `npx expo start`.
#
# EXPO_PUBLIC_* values are compiled into the app and readable by anyone who
# has it, so only public values belong here: the API's address and the
# Supabase project's URL and *publishable* key. A secret or service-role key
# must never be given this prefix.
#
# For the local stack, `supabase status` prints the URL and publishable key.
# A phone on the same Wi-Fi cannot reach 127.0.0.1 on the laptop: use the
# laptop's LAN address for both URLs.

EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
