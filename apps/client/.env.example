# Copy to apps/client/.env.local (gitignored). NEXT_PUBLIC_ values are compiled into the client and visible to anyone:
# never put a server secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 1 turns on the offline shell (service worker). Off by default, because a
# worker in front of a development server caches code that is about to change.
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=0
# Shown under Settings; a release build sets it to its version.
NEXT_PUBLIC_APP_VERSION=
# The demo accounts' password, for the "Try the demo" one-click sign-in. Set it to
# the value given to `python -m app.demo_setup --password`; empty hides the buttons.
# Compiled into the client, so only ever a demo account's password.
NEXT_PUBLIC_DEMO_PASSWORD=
